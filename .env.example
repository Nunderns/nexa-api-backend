# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexa_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"

# Server
PORT=3000
NODE_ENV=development

# HTTP security
# Allowed CORS origin(s), comma-separated. Required in production;
# defaults to http://localhost:5173 otherwise.
# FRONTEND_URL=https://nexa.example.com
# Max JSON/urlencoded body size (uploads are limited separately)
# BODY_LIMIT=100kb

# Rate limiting (all optional, safe defaults apply)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
# CHAT_CREATE_IP_RATE_LIMIT_MAX=30
# CHAT_CREATE_RATE_LIMIT_MAX=10
# CHAT_MESSAGE_IP_RATE_LIMIT_MAX=60
# CHAT_MESSAGE_RATE_LIMIT_MAX=20
# USER_RATE_LIMIT_MAX=200
# POST_VIEW_IP_RATE_LIMIT_MAX=120
# INSIGHTS_IP_RATE_LIMIT_MAX=30

# Per-user write budgets (bound notification spam at the source)
# COMMENT_WRITE_RATE_LIMIT_MAX=20
# POST_WRITE_RATE_LIMIT_MAX=10
# VOTE_RATE_LIMIT_MAX=60
# Notifications
# NOTIFICATION_PREFERENCES_RATE_LIMIT_MAX=10
# NOTIFICATION_BULK_RATE_LIMIT_MAX=10
# WS_CONNECT_IP_RATE_LIMIT_MAX=30

# Media uploads (all optional)
# UPLOAD_DIR=uploads
# MEDIA_MAX_IMAGE_MB=10
# MEDIA_MAX_VIDEO_MB=100
# Public base URL for media links, e.g. behind a proxy
# PUBLIC_API_URL=https://api.example.com
