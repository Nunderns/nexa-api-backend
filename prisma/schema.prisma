// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CommunityRole {
  MEMBER
  MODERATOR
  OWNER
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  LINK
}

enum NotificationType {
  POST_REPLY
  COMMENT_REPLY
  USER_MENTION
  POST_UPVOTE
  COMMENT_UPVOTE
  DIRECT_MESSAGE
  SYSTEM
}

/// What `Notification.resourceId` points at. There is no foreign key behind
/// it (the target table depends on the type), so a deleted resource simply
/// leaves a notification that resolves to a 404 on the client.
enum NotificationResourceType {
  POST
  COMMENT
  CHAT
}

model User {
  id                       Int                      @id @default(autoincrement())
  username                 String                   @unique @db.VarChar(30)
  email                    String                   @unique @db.VarChar(255)
  passwordHash             String                   @map("password_hash") @db.Text
  displayName              String                   @map("display_name") @db.VarChar(100)
  bio                      String?                  @db.Text
  avatarUrl                String?                  @map("avatar_url") @db.Text
  karma                    Int                      @default(0)
  isActive                 Boolean                  @default(true) @map("is_active")
  isEmailVerified          Boolean                  @default(false) @map("is_email_verified")
  emailVerificationToken   String?                  @unique @map("email_verification_token") @db.Text
  emailVerificationExpires DateTime?                @map("email_verification_expires") @db.Timestamptz
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  // Generated by the database (see the full-text search migration); read
  // only through raw SQL.
  searchVector             Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  // Relations
  communitiesCreated       Community[]             @relation("CommunityCreator")
  communityMemberships     CommunityMember[]
  posts                    Post[]
  comments                 Comment[]
  postVotes                PostVote[]
  commentVotes             CommentVote[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  media                    Media[]
  chatsAsFirstParticipant  Chat[]                  @relation("ChatParticipantOne")
  chatsAsSecondParticipant Chat[]                  @relation("ChatParticipantTwo")
  sentMessages             Message[]
  notificationsReceived    Notification[]          @relation("NotificationRecipient")
  notificationsTriggered   Notification[]          @relation("NotificationActor")
  notificationPreference   NotificationPreference?

  @@index([searchVector], type: Gin)
  @@map("users")
}

model Community {
  id           Int                      @id @default(autoincrement())
  name         String                   @unique @db.VarChar(50)
  displayName  String                   @map("display_name") @db.VarChar(100)
  description  String?                  @db.Text
  iconUrl      String?                  @map("icon_url") @db.Text
  bannerUrl    String?                  @map("banner_url") @db.Text
  isPrivate    Boolean                  @default(false) @map("is_private")
  isNsfw       Boolean                  @default(false) @map("is_nsfw")
  memberCount  Int                      @default(0) @map("member_count")
  postCount    Int                      @default(0) @map("post_count")
  createdBy    Int                      @map("created_by")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  // Generated by the database (see the full-text search migration); read
  // only through raw SQL.
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  // Relations
  creator User              @relation("CommunityCreator", fields: [createdBy], references: [id])
  members CommunityMember[]
  posts   Post[]

  @@index([searchVector], type: Gin)
  @@map("communities")
}

model CommunityMember {
  communityId Int           @map("community_id")
  userId      Int           @map("user_id")
  role        CommunityRole
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz
  bannedAt    DateTime?     @map("banned_at") @db.Timestamptz

  // Relations
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@map("community_members")
}

model Post {
  id            Int                      @id @default(autoincrement())
  communityId   Int                      @map("community_id")
  authorId      Int                      @map("author_id")
  title         String                   @db.VarChar(300)
  content       String?                  @db.Text
  postType      PostType                 @map("post_type")
  score         Int                      @default(0)
  upvoteCount   Int                      @default(0) @map("upvote_count")
  downvoteCount Int                      @default(0) @map("downvote_count")
  commentCount  Int                      @default(0) @map("comment_count")
  // Reach counters. Denormalized for the same reason `commentCount` is: the
  // post detail page reads them on every load, and counting rows per request
  // would turn a cheap read into an aggregate scan.
  viewCount     Int                      @default(0) @map("view_count")
  shareCount    Int                      @default(0) @map("share_count")
  repostCount   Int                      @default(0) @map("repost_count")
  awardCount    Int                      @default(0) @map("award_count")
  isPinned      Boolean                  @default(false) @map("is_pinned")
  isLocked      Boolean                  @default(false) @map("is_locked")
  isDeleted     Boolean                  @default(false) @map("is_deleted")
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  // Generated by the database (see the full-text search migration); read
  // only through raw SQL.
  searchVector  Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  // Relations
  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes     PostVote[]
  comments  Comment[]
  media     Media[]
  views     PostView[]
  viewStats PostViewStat[]

  // Feeds sort by `score`, which leans on the vote columns, and the insights
  // endpoint reads the reach counters, so both column groups are hot.
  @@index([communityId, isDeleted, score])
  @@index([authorId, isDeleted])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  @@map("posts")
}

/// One recorded visit to a post.
///
/// Raw events are kept because "who saw this post and when" cannot be
/// recovered from the hourly rollup, and the rollup cannot be corrected
/// retroactively if the deduplication rule changes. Growth is bounded by the
/// per-IP/per-user rate limits on `POST /posts/:id/view`, and rows can be
/// pruned by age without affecting the totals.
model PostView {
  id          Int      @id @default(autoincrement())
  postId      Int      @map("post_id")
  /// Stable hash of the visitor (user id when signed in, client IP otherwise).
  /// Hashed rather than stored raw so the table cannot be used to re-identify
  /// anonymous readers, while still allowing per-visitor deduplication.
  viewerKey   String   @map("viewer_key") @db.VarChar(64)
  /// ISO 3166-1 alpha-2, or `XX` when the country cannot be determined.
  countryCode String   @default("XX") @map("country_code") @db.VarChar(2)
  viewedAt    DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// Serves the per-visitor dedupe window: "has this visitor already been
  /// counted for this post since <cutoff>".
  @@index([postId, viewerKey, viewedAt])
  /// Serves the hourly rollup read and any time-range filter.
  @@index([postId, viewedAt])
  @@map("post_views")
}

/// Hourly pre-aggregated views for a post, split by country.
///
/// The insights screen reads 48 buckets on every load and groups by country;
/// deriving both from `PostView` would scan every raw row the post has ever
/// accumulated. This table is written on the same path that appends the raw
/// event, so the two can only drift if the write is interrupted.
model PostViewStat {
  postId      Int      @map("post_id")
  /// Start of the hour, always minute/second/millisecond zero.
  bucketStart DateTime @map("bucket_start") @db.Timestamptz
  /// ISO 3166-1 alpha-2, or `XX` when the country cannot be determined.
  countryCode String   @map("country_code") @db.VarChar(2)
  views       Int      @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// One row per (post, hour, country), which also covers "views of this post
  /// over time" and "views of this post by country" as index scans.
  @@id([postId, bucketStart, countryCode])
  @@index([postId, bucketStart])
  @@map("post_view_stats")
}

model Comment {
  id            Int      @id @default(autoincrement())
  postId        Int      @map("post_id")
  authorId      Int      @map("author_id")
  parentId      Int?     @map("parent_id")
  content       String   @db.Text
  score         Int      @default(0)
  upvoteCount   Int      @default(0) @map("upvote_count")
  downvoteCount Int      @default(0) @map("downvote_count")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  votes   CommentVote[]
  media   Media[]

  @@map("comments")
}

model PostVote {
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  vote      Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("post_votes")
}

model CommentVote {
  userId    Int      @map("user_id")
  commentId Int      @map("comment_id")
  vote      Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@map("comment_votes")
}

/// One-to-one conversation between two users.
///
/// The two participants are stored in a canonical order
/// (`user_one_id < user_two_id`, enforced by a database check constraint) so
/// that A -> B and B -> A always resolve to the same row. The matching unique
/// constraint is what actually prevents duplicates under concurrent requests.
model Chat {
  id            Int       @id @default(autoincrement())
  /// Always the lower user id of the pair.
  userOneId     Int       @map("user_one_id")
  /// Always the higher user id of the pair.
  userTwoId     Int       @map("user_two_id")
  /// Timestamp of the most recent message, denormalized so listing a user's
  /// chats can be ordered by recent activity without touching `messages`.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  userOne  User      @relation("ChatParticipantOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ChatParticipantTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId, lastMessageAt])
  @@index([userTwoId, lastMessageAt])
  @@map("chats")
}

/// A single message inside a one-to-one conversation.
model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int      @map("chat_id")
  senderId  Int      @map("sender_id")
  /// Bounded at the database level as well, mirroring the DTO max length, so
  /// an oversized message cannot be persisted by any other code path.
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Covers "messages of a chat, oldest first" and "messages of a chat, newest
  // first", which are the two directions the API reads them in.
  @@index([chatId, id])
  @@index([chatId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Media {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  postId     Int?     @map("post_id")
  commentId  Int?     @map("comment_id")
  storageKey String   @map("storage_key") @db.Text
  url        String   @db.Text
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt   @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("media")
}

/// Persistent, per-recipient notification. The table is the source of truth;
/// the WebSocket push is only a hint that something new is here.
///
/// Notifications never carry user-written text: `title` and `body` are built
/// server-side from fixed templates and usernames (which are restricted to
/// `[A-Za-z0-9_]`), and `metadata` only holds identifiers. Message contents in
/// particular are never copied here.
model Notification {
  id           String                    @id @default(uuid()) @db.Uuid
  recipientId  Int                       @map("recipient_id")
  /// Null for system notifications, or once the actor's account is deleted.
  actorId      Int?                      @map("actor_id")
  type         NotificationType
  title        String                    @db.VarChar(120)
  body         String                    @db.VarChar(300)
  resourceType NotificationResourceType? @map("resource_type")
  resourceId   Int?                      @map("resource_id")
  metadata     Json?
  /// Idempotency key for the event that produced the notification, e.g.
  /// `comment:42:reply` or `vote:post:7:user:3`. Unique per recipient, so a
  /// retried or duplicated event and an unchanged edit can never notify the
  /// same person twice.
  dedupeKey    String?                   @map("dedupe_key") @db.VarChar(120)
  isRead       Boolean                   @default(false) @map("is_read")
  readAt       DateTime?                 @map("read_at") @db.Timestamptz
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([recipientId, dedupeKey])
  /// Newest-first listing with a stable `(createdAt, id)` cursor.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  /// Unread listing and the unread count.
  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("notifications")
}

/// Per-user notification settings. A missing row means every category is on,
/// so existing users need no backfill.
///
/// A disabled category suppresses the notification entirely: nothing is
/// stored and nothing is pushed. `SYSTEM` notifications have no switch.
model NotificationPreference {
  userId         Int      @id @map("user_id")
  postReplies    Boolean  @default(true) @map("post_replies")
  commentReplies Boolean  @default(true) @map("comment_replies")
  mentions       Boolean  @default(true)
  votes          Boolean  @default(true)
  directMessages Boolean  @default(true) @map("direct_messages")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
