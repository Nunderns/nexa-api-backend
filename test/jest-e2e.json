{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs/(jwt|passport|config))/)"
  ],
  "globalSetup": "<rootDir>/db/global-setup.ts",
  "globalTeardown": "<rootDir>/db/global-teardown.ts",
  "maxWorkers": 1
}
